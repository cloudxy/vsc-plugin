      "command": "vsc-sound",
      "skill": "vsc-sound",
      "entry": {
        "mode": "sound",
        "summary": "BGM、环境声、声音桥",
        "description": "VSC 声音叙事：根据场景、人物目标与情绪节拍设计 BGM、环境底、对白空间、声音桥与混音提示。",
        "argument_hint": "[项目 | 第N集 | 场次 | BGM | 环境声 | 声音提示表]"
