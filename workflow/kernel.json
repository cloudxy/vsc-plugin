      "command": "vsc-post",
      "skill": "vsc-post",
      "entry": {
        "mode": "post",
        "summary": "剪辑、混音、审片、交付",
        "description": "VSC 后期：剪辑时间线、转场、对白、音乐、音效、字幕、混音、审片与交付。",
        "argument_hint": "[项目 | 第N集 | 时间线 | 审片]"
      },
      "roles": ["editor", "post-reviewer"],
      "profile_stages": ["post", "delivery"],
      "contracts": ["vsc.sound-cue-sheet/v1"],
      "vendor_skill_stage": "post"
    },
    {
      "id": "remotion",
      "command": "vsc-remotion",
      "skill": "vsc-remotion",
      "entry": {
        "mode": "remotion",
        "summary": "Remotion 预演与导出",
        "description": "VSC Remotion：将已批准的镜头、声音与字幕编译为可编辑预览和确定性渲染项目。",
        "argument_hint": "[项目 | 第N集 | 时间线 | Remotion 预演 | 导出计划]"
      },
      "roles": ["remotion-composer", "editor"],
      "profile_stages": ["post", "delivery"],
      "contracts": ["vsc.remotion-render-plan/v1"]
    },
    {
      "id": "learn",
      "command": "vsc-learn",
      "skill": "vsc-learn",
      "entry": {
        "mode": "learning",
        "summary": "方法学习、能力卡与评测",
        "description": "VSC 学习：把有权属的图像、视频、音频或文本素材，经观察、试用与评测沉淀为受控能力卡；不自动训练模型或复制风格。",
        "argument_hint": "[项目 | 素材 | 动作/特效/构图/情绪/对白/声音/剪辑 | 能力评测]"
