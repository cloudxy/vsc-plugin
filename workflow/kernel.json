  "stages": [
    {
      "id": "orchestrate",
      "command": "vsc",
      "skill": "vsc",
      "entry": {
        "mode": "auto",
        "summary": "总编排、创建、进度",
        "description": "VSC 总编排入口：从小说、原创故事或品牌资料到剧本、镜头、资产、图像、视频、声音、剪辑与交付；支持改编、连续性、声音契约及受控学习；为新手引导，为熟手路由到专用能力。",
        "argument_hint": "[一句话需求 | 新建项目 | 改编 | 剧本 | 分镜 | 连续性 | 声音/BGM | 资产 | 生成 | 剪辑 | Remotion 预演/导出 | 审片 | 学习 | 状态]"
      },
      "roles": ["orchestrator"],
      "profile_stages": ["brief", "source", "delivery"],
      "contracts": ["creative-handoff/v1", "vsc.role-context/v1", "vsc.sequence-links/v1"]
    },
    {
      "id": "adapt",
      "command": "vsc-adapt",
      "skill": "vsc-adapt",
      "entry": {
        "mode": "adapt",
        "summary": "小说理解、改编、分集",
