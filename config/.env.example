# Dynaconf 自动读取本文件的本机副本：复制为 config/.env，填写应用读写账号。
# 默认配置位于 config/default/settings.toml；.env 优先于同名进程变量。
# MCP 正式库使用独立只读账号，不要将它填入应用连接。
# 两库使用同一个 PostgreSQL 实例和端口；测试库以 _test 结尾。
VSC_DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:55432/vsc_resources
VSC_TEST_DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:55432/vsc_resources_test
# 可选：本机受控媒体目录。
# VSC_MEDIA_ROOT=.vsc-resource-media
# 可选：实际操作人只初始化一次；不设置则继续只读浏览。
# VSC_PANEL_WRITABLE=true
# VSC_PANEL_HUMAN_IDENTITY=填写实际操作人的名字
# 本机单人使用时可关闭登录步骤；仍需启用写入并设置操作人，仅接受本机同源页面。
# VSC_PANEL_REQUIRE_LOGIN=false
# 从启动器以 vsc-panel --open 打开，会建立短时单次的本机操作会话。
# 可选：平台官方资产发布者的实际身份。普通共享素材不会自动成为官方资产。
# VSC_OFFICIAL_ASSET_PUBLISHERS='@json ["trusted-operator"]'
# 可选：外部身份通道（默认停用）。详见 config/default/settings.toml 的 AUTHENTICATION。
# 使用 Dynaconf 嵌套键填写账号和回调地址；不会调整既有端口或数据库授权。
# VSC_AUTHENTICATION__ENABLED=true
# VSC_AUTHENTICATION__EMAIL__ENABLED=true
# VSC_AUTHENTICATION__EMAIL__HOST=smtp.example.com
# VSC_AUTHENTICATION__EMAIL__USERNAME=login@example.com
# VSC_AUTHENTICATION__EMAIL__FROM_ADDRESS=login@example.com
# VSC_AUTHENTICATION__SMS__ENABLED=true
# VSC_AUTHENTICATION__SMS__ACCOUNT_SID=YOUR_ACCOUNT_SID
# VSC_AUTHENTICATION__SMS__API_KEY_SID=YOUR_API_KEY_SID
# VSC_AUTHENTICATION__SMS__FROM_NUMBER=YOUR_SENDER_NUMBER
# VSC_AUTHENTICATION__OIDC__PROVIDERS__GOOGLE__ENABLED=true
# VSC_AUTHENTICATION__OIDC__PROVIDERS__GOOGLE__CLIENT_ID=YOUR_CLIENT_ID
# VSC_AUTHENTICATION__OIDC__PROVIDERS__GOOGLE__REDIRECT_URI=https://YOUR_DEPLOYMENT/api/v1/authentication/oidc/google/callback
# 密钥只由 ~/.zshenv 的 AUTH_CHALLENGE_KEY（至少32字节）、VSC_SMTP_PASSWORD、
# TWILIO_API_KEY_SECRET、GOOGLE_OIDC_CLIENT_SECRET 加载；配置只保存以上变量引用。
