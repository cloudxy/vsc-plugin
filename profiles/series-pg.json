      "vsc.asset_bible"
    ],
    "vsc.selected_takes": [
      "vsc.animatic"
    ],
    "vsc.timeline": [
      "vsc.selected_takes"
    ],
    "vsc.mix": [
      "vsc.timeline",
      "vsc.sound_plan"
    ],
    "vsc.media_qa": [
      "vsc.timeline",
      "vsc.mix"
    ],
    "vsc.sample_review": [
      "vsc.media_qa"
    ],
    "vsc.delivery_manifest": [
      "vsc.timeline",
      "vsc.mix",
      "vsc.media_qa",
      "vsc.sample_review"
    ],
    "vsc.production_run": [],
