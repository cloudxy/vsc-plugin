{
  "profile_id": "vsc.light-short",
  "version": "3.0",
  "dependency_policy": "previous_stage",
  "label": "轻量单条短视频",
  "use_case": "原创单条短视频；与存储策略分离，固定制作方案后按必要输入直接制作，预演按需启用",
  "stages": [
    {
      "id": "brief",
      "label": "创作委托",
      "required": [
        "vsc.creative_brief"
      ]
    },
    {
      "id": "script",
      "label": "剧本",
      "required": [
        "vsc.screenplay"
      ]
    },
    {
      "id": "design",
      "label": "视听与资产设计",
      "required": [
        "vsc.asset_bible",
        "vsc.shot_plan",
        "vsc.sound_plan",
        "vsc.coverage_plan"
      ]
    },
    {
      "id": "production",
      "label": "素材制作",
      "required": [
        "vsc.selected_takes"
      ]
    },
    {
      "id": "post",
      "label": "剪辑与后期",
      "required": [
        "vsc.timeline",
        "vsc.mix"
      ]
    },
    {
      "id": "delivery",
      "label": "审片与交付",
      "required": [
        "vsc.delivery_manifest",
        "vsc.sample_review",
        "vsc.media_qa"
      ]
    }
  ],
  "policy": {
    "creative_decisions": "human",
    "technical_checks": "automatic",
    "external_publish": "not_enabled",
    "review_mode": "fixed-version-bundle"
  },
  "contract_policy": "production-v2",
  "ending_functions": [
    "closure",
    "resonance",
    "action",
    "cliffhanger"
  ],
  "dependency_requirements": {
    "vsc.coverage_plan": [
      "vsc.screenplay"
    ],
    "vsc.shot_plan": [
      "vsc.screenplay"
    ],
    "vsc.sound_plan": [
      "vsc.screenplay"
    ],
    "vsc.animatic": [
      "vsc.coverage_plan",
      "vsc.asset_bible"
    ],
    "vsc.selected_takes": [
      "vsc.coverage_plan",
      "vsc.shot_plan",
      "vsc.asset_bible"
    ],
    "vsc.timeline": [
      "vsc.selected_takes"
    ],
    "vsc.mix": [
      "vsc.timeline",
      "vsc.sound_plan"
    ],
    "vsc.media_qa": [
      "vsc.timeline",
      "vsc.mix"
    ],
    "vsc.sample_review": [
      "vsc.media_qa"
    ],
    "vsc.delivery_manifest": [
      "vsc.timeline",
      "vsc.mix",
      "vsc.media_qa",
      "vsc.sample_review"
    ],
    "vsc.production_run": [],
    "vsc.episode_beats": [
      "vsc.adaptation_plan"
    ]
  },
  "max_episodes": 1,
  "production_policy": "light-short-v1",
  "optional_artifacts": {
    "design": [
      "vsc.animatic"
    ],
    "script": [
      "vsc.source_map",
      "vsc.story_bible",
      "vsc.adaptation_plan"
    ]
  },
  "scope_required_from": "script"
}
