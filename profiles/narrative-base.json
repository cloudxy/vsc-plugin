    {"id": "script", "label": "剧本", "required": ["vsc.screenplay"]},
    {"id": "design", "label": "视听与资产设计", "required": ["vsc.visual_bible", "vsc.asset_bible", "vsc.shot_plan"]},
    {"id": "animatic", "label": "分镜预演", "required": ["vsc.animatic"]},
    {"id": "production", "label": "素材制作", "required": ["vsc.selected_takes"]},
    {"id": "post", "label": "剪辑与后期", "required": ["vsc.timeline"]},
    {"id": "delivery", "label": "审片与交付", "required": ["vsc.delivery_manifest"]}
  ],
  "policy": {"creative_decisions": "human", "technical_checks": "automatic", "external_publish": "not_enabled"}
