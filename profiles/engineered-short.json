      "vsc.sound_plan"
    ],
    "vsc.media_qa": [
      "vsc.timeline",
      "vsc.mix"
    ],
    "vsc.sample_review": [
      "vsc.media_qa"
    ],
    "vsc.delivery_manifest": [
      "vsc.timeline",
