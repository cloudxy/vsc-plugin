# 本地下载的第三方 Skill、模型辅助工具、缓存和构建物不进入 VSC 源码仓库。
/vendor/*
!/vendor/README.md
!/vendor/sources.lock.json
!/vendor/THIRD_PARTY.md

__pycache__/
*.py[cod]
.DS_Store

# Python packaging and isolated development environments.
/build/
/dist/
*.egg-info/
/.venv/
/.vsc-resource-media/
/.vsc-local/

# 作品目录与跨作品素材库为本地创作数据，不进入 VSC 源码仓库。
/projects/
/library/

# ZCode 本地索引排除配置。
/.zcodeignore

# ZCode video-agent-kit 插件的本机运行状态。
/.video_agent/

# 编辑器与客户端的个人本机配置。
/.idea/
/.claude/settings.local.json

# 本地工作执行计划，仅保存在维护者工作区。
/docs/plans/

# ZCode 宿主的本地会话状态。
/.zcode/

# 本机初始化配置只保留示例；真实连接与凭据不提交。
.env
.env.*
!/config/.env.example
/config/mcp/
